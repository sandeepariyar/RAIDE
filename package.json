{
  "name": "raide",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-tokens.mjs && vite --host 0.0.0.0",
    "build": "node scripts/build-tokens.mjs && tsc --noEmit && vite build && npm run build:storybook",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "node scripts/storybook-build.mjs",
    "format": "prettier --write src .storybook scripts/*.mjs design/*.json *.json *.md"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.14",
    "@types/d3-geo": "^3.1.0",
    "prettier": "^3.6.2",
    "storybook": "^8.6.14",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
